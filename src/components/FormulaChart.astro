---
// Line chart: each formula's estimate as a % of the weight lifted, 2–12 reps.
// Drawn at build time as inline SVG from formulaGrid() — the same numbers as
// the table beside it (which is also this chart's accessible table view).
// Colours: categorical slots 1–6, validated for the light (#ffffff) and dark
// (#181b22) card surfaces. Hover/focus shows every formula at the nearest rep.
import { FORMULAS, formulaGrid } from '../lib/onerepmax.js';

const rows = formulaGrid(2, 12);
const W = 640, H = 340;
const m = { top: 16, right: 16, bottom: 56, left: 62 };
const iw = W - m.left - m.right, ih = H - m.top - m.bottom;
const allValues = rows.flatMap((r) => FORMULAS.map((f) => r.byFormula[f.id]));
const yMin = 100;
const yMax = Math.ceil(Math.max(...allValues) / 10) * 10;
const x = (reps: number) => m.left + ((reps - 2) / 10) * iw;
const y = (v: number) => m.top + ih - ((v - yMin) / (yMax - yMin)) * ih;
const yTicks = Array.from({ length: (yMax - yMin) / 10 + 1 }, (_, i) => yMin + i * 10);
const xTicks = rows.map((r) => r.reps);
const lines = FORMULAS.map((f, i) => ({
  id: f.id,
  name: f.name,
  slot: i + 1,
  d: rows.map((r, j) => `${j === 0 ? 'M' : 'L'}${x(r.reps).toFixed(1)},${y(r.byFormula[f.id]).toFixed(1)}`).join(' '),
}));
// Data for the hover readout, serialised once.
const hoverData = JSON.stringify({
  reps: xTicks,
  xs: xTicks.map((r) => Number(x(r).toFixed(1))),
  series: FORMULAS.map((f, i) => ({ name: f.name, slot: i + 1, values: rows.map((r) => Number(r.byFormula[f.id].toFixed(1))) })),
});
---
<figure class="fchart" data-formula-chart data-hover={hoverData}>
  <figcaption class="fchart-title">How the six formulas spread apart as reps increase</figcaption>
  <ul class="fchart-legend" aria-label="Legend">
    {lines.map((l) => <li><span class="fchart-key" style={`--c: var(--fc-${l.slot})`} aria-hidden="true"></span>{l.name}</li>)}
  </ul>
  <div class="fchart-plot">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" tabindex="0"
      aria-label="Line chart of each formula's 1RM estimate as a percentage of the weight lifted, from 2 to 12 reps. The same values are in the table below. Use the left and right arrow keys to read the values at each rep count.">
      <g class="fchart-grid">
        {yTicks.map((t) => (
          <g>
            <line x1={m.left} x2={W - m.right} y1={y(t)} y2={y(t)} />
            <text x={m.left - 8} y={y(t)} dy="0.32em" text-anchor="end">{t}%</text>
          </g>
        ))}
        {xTicks.map((t) => <text x={x(t)} y={H - m.bottom + 24} text-anchor="middle">{t}</text>)}
        <text x={m.left + iw / 2} y={H - 6} text-anchor="middle" class="fchart-axis-title">Reps completed</text>
      </g>
      {lines.map((l) => <path d={l.d} class="fchart-line" style={`--c: var(--fc-${l.slot})`} />)}
      <line class="fchart-cross" x1="0" x2="0" y1={m.top} y2={m.top + ih} hidden />
      <rect class="fchart-hit" x={m.left - 12} y={m.top} width={iw + 24} height={ih} />
    </svg>
    <div class="fchart-tip" role="status" aria-live="polite" hidden></div>
  </div>
</figure>

<style>
  .fchart {
    --fc-1: #2a78d6; --fc-2: #eb6834; --fc-3: #1baf7a; --fc-4: #eda100; --fc-5: #e87ba4; --fc-6: #008300;
    margin: 1.25rem 0;
    padding: 1rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 10px;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .fchart {
      --fc-1: #3987e5; --fc-2: #d95926; --fc-3: #199e70; --fc-4: #c98500; --fc-5: #d55181; --fc-6: #008300;
    }
  }
  :global(:root[data-theme="dark"]) .fchart {
    --fc-1: #3987e5; --fc-2: #d95926; --fc-3: #199e70; --fc-4: #c98500; --fc-5: #d55181; --fc-6: #008300;
  }
  .fchart-title { font-weight: 600; margin-bottom: 0.5rem; color: var(--text); }
  .fchart-legend { display: flex; flex-wrap: wrap; gap: 0.35rem 1rem; list-style: none; padding: 0; margin: 0 0 0.5rem; font-size: 0.85rem; color: var(--text-muted); }
  .fchart-legend li { display: inline-flex; align-items: center; gap: 0.4rem; margin: 0; }
  .fchart-key { display: inline-block; width: 16px; height: 0; border-top: 2px solid var(--c); border-radius: 1px; }
  .fchart-plot { position: relative; }
  .fchart svg { display: block; width: 100%; height: auto; overflow: visible; }
  .fchart svg:focus-visible { outline: 2px solid var(--focus); outline-offset: 4px; border-radius: 4px; }
  .fchart-grid line { stroke: var(--border); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .fchart-grid text { fill: var(--text-muted); font-size: 12px; }
  .fchart-axis-title { font-size: 12px; }
  /* The SVG scales down on phones; larger text units keep labels readable (~11px). */
  @media (max-width: 600px) {
    .fchart { padding: 0.75rem; }
    .fchart-grid text, .fchart-axis-title { font-size: 20px; }
  }
  .fchart-line { fill: none; stroke: var(--c); stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; vector-effect: non-scaling-stroke; }
  .fchart-cross { stroke: var(--text-muted); stroke-width: 1; vector-effect: non-scaling-stroke; }
  /* SVG elements ignore the hidden attribute without this. */
  .fchart-cross[hidden] { display: none; }
  .fchart-hit { fill: transparent; cursor: crosshair; }
  .fchart-tip {
    position: absolute; top: 0; pointer-events: none; min-width: 9.5rem;
    background: var(--card); color: var(--text); border: 1px solid var(--border); border-radius: 8px;
    box-shadow: var(--shadow); padding: 0.45rem 0.6rem; font-size: 0.8rem;
  }
  .fchart-tip[hidden] { display: none; }
  .fchart-tip :global(.tip-head) { color: var(--text-muted); margin-bottom: 0.2rem; }
  .fchart-tip :global(.tip-row) { display: flex; align-items: center; gap: 0.4rem; }
  .fchart-tip :global(.tip-row strong) { min-width: 3.4rem; text-align: right; font-variant-numeric: tabular-nums; }
  .fchart-tip :global(.tip-key) { width: 12px; height: 0; border-top: 2px solid var(--c); }
  .fchart-tip :global(.tip-name) { color: var(--text-muted); }
</style>

<script>
  type Hover = { reps: number[]; xs: number[]; series: { name: string; slot: number; values: number[] }[] };

  document.querySelectorAll<HTMLElement>('[data-formula-chart]').forEach((fig) => {
    const data: Hover = JSON.parse(fig.dataset.hover!);
    const svg = fig.querySelector('svg')!;
    const hit = fig.querySelector<SVGRectElement>('.fchart-hit')!;
    const cross = fig.querySelector<SVGLineElement>('.fchart-cross')!;
    const tip = fig.querySelector<HTMLElement>('.fchart-tip')!;
    let index = -1;

    function show(i: number) {
      index = i;
      const xv = data.xs[i];
      cross.setAttribute('x1', String(xv));
      cross.setAttribute('x2', String(xv));
      cross.removeAttribute('hidden');
      // Labels go in with textContent (never innerHTML); values lead, sorted high to low.
      tip.replaceChildren();
      const head = document.createElement('div');
      head.className = 'tip-head';
      head.textContent = `${data.reps[i]} reps — % of weight lifted`;
      tip.append(head);
      [...data.series].sort((a, b) => b.values[i] - a.values[i]).forEach((s) => {
        const row = document.createElement('div');
        row.className = 'tip-row';
        const value = document.createElement('strong');
        value.textContent = `${s.values[i].toFixed(1)}%`;
        const key = document.createElement('span');
        key.className = 'tip-key';
        key.style.setProperty('--c', `var(--fc-${s.slot})`);
        const name = document.createElement('span');
        name.className = 'tip-name';
        name.textContent = s.name;
        row.append(value, key, name);
        tip.append(row);
      });
      tip.hidden = false;
      // Place the readout beside the crosshair, flipping left near the right edge.
      const scale = svg.getBoundingClientRect().width / svg.viewBox.baseVal.width;
      const px = xv * scale;
      const plotWidth = svg.getBoundingClientRect().width;
      const left = px + 12 + tip.offsetWidth > plotWidth ? px - 12 - tip.offsetWidth : px + 12;
      tip.style.left = `${Math.max(0, left)}px`;
    }
    function hide() {
      index = -1;
      cross.setAttribute('hidden', '');
      tip.hidden = true;
    }
    function nearest(clientX: number) {
      const rect = svg.getBoundingClientRect();
      const vx = ((clientX - rect.left) / rect.width) * svg.viewBox.baseVal.width;
      let best = 0;
      data.xs.forEach((xv, i) => { if (Math.abs(xv - vx) < Math.abs(data.xs[best] - vx)) best = i; });
      return best;
    }

    hit.addEventListener('pointermove', (e) => show(nearest(e.clientX)));
    hit.addEventListener('pointerleave', hide);
    svg.addEventListener('focus', () => show(index < 0 ? 3 : index));
    svg.addEventListener('blur', hide);
    svg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); show(Math.min(data.xs.length - 1, index + 1)); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); show(Math.max(0, index - 1)); }
      if (e.key === 'Escape') hide();
    });
  });
</script>
