---
// AdSlot — reserved, clearly labelled advertising position.
//
// Renders NOTHING until both are true:
//   1. ads are enabled in src/config/ads.ts (PUBLIC_ADSENSE_CLIENT set), and
//   2. a slot id is passed for this placement.
// The loader script is added once in BaseLayout by the same switch.
//
// Placement rules (enforced by where pages use this component):
// - never above the calculator or between inputs and results;
// - never next to calculator buttons (accidental clicks);
// - at most one slot per screenful of content on mobile;
// - fixed min-height so a loading ad does not shift the layout (CLS).
//
// See src/config/ads.ts for everything else the switch turns on.
import { ADSENSE_CLIENT } from '../config/ads';
interface Props {
  /** AdSense ad-unit slot id for this placement. */
  slot?: string;
  /** Reserved height in px to prevent layout shift. */
  minHeight?: number;
}
const { slot, minHeight = 280 } = Astro.props;
const client = ADSENSE_CLIENT;
const enabled = Boolean(client && slot);
---
{enabled && (
  <aside class="ad-slot no-print" aria-label="Advertisement" style={`min-height:${minHeight}px`}>
    <span class="ad-label">Advertisement</span>
    <ins class="adsbygoogle" style="display:block" data-ad-client={client} data-ad-slot={slot}
      data-ad-format="auto" data-full-width-responsive="true"></ins>
    <script is:inline>(window.adsbygoogle = window.adsbygoogle || []).push({});</script>
  </aside>
)}
