---
// The public contact address from SITE.contactEmail, or — until it is set — a
// clearly marked notice (the build also warns). Never invents an address.
//
// The email_off comments stop Cloudflare's Email Obfuscation from rewriting the
// link to /cdn-cgi/l/email-protection, which crawlers see as a broken (404)
// link. The address is public anyway (it is also in the site's JSON-LD).
import { SITE } from '../config/site';
const email = SITE.contactEmail;
---
{email
  ? <Fragment set:html={`<!--email_off--><a href="mailto:${email}">${email}</a><!--/email_off-->`} />
  : <strong class="todo">[contact email not yet configured]</strong>}
