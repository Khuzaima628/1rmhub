---
// Site footer: every public page is linked here (no orphan pages), plus the
// standing disclaimer. Estimates are educational — never medical advice,
// never guaranteed results.
import { FOOTER_GROUPS, SITE } from '../config/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <nav class="footer-links" aria-label="Footer">
      {FOOTER_GROUPS.map((group) => (
        <div>
          <h2 class="footer-title">{group.title}</h2>
          <ul>
            {group.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          </ul>
        </div>
      ))}
    </nav>
    <p class="footer-note">
      All results are <em>estimates</em> from published formulas — not guaranteed
      lifting performance and not medical advice. Maximal lifting carries risk:
      use proper technique, equipment, and supervision. <a href="/disclaimer/">Full disclaimer</a>.
    </p>
    <p class="footer-note">© {year} {SITE.name}. Free to use, no signup.</p>
  </div>
</footer>
