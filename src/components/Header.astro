---
// Site header: brand, primary navigation and the light/dark theme button.
// The current section is marked with aria-current for users and styling.
import { NAV } from '../config/site';
interface Props { path: string }
const { path } = Astro.props;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="1RMHub home">1RM<span>Hub</span></a>
    <nav class="site-nav" aria-label="Primary">
      {NAV.map((item) => (
        <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>
    <!-- Icon + word name the theme the button switches TO. Which pair shows is
         decided in CSS (global.css), so it is correct before scripts run; the
         script below only keeps the accessible name in step. Inline SVG, not
         emoji or symbol characters, so it renders the same on every device. -->
    <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Switch colour theme">
      <span class="when-light">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      </span>
      <span class="when-dark">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.5"/><path d="M12 1.5v2.5M12 20v2.5M1.5 12H4M20 12h2.5M4.6 4.6l1.8 1.8M17.6 17.6l1.8 1.8M4.6 19.4l1.8-1.8M17.6 6.4l1.8-1.8"/></svg>
      </span>
      <span class="when-light" aria-hidden="true">Dark</span>
      <span class="when-dark" aria-hidden="true">Light</span>
    </button>
  </div>
</header>

<script>
  import { setPref } from '../scripts/prefs.js';

  // The saved theme (if any) is already on <html data-theme> from the inline
  // head script; otherwise the system setting applies.
  const btn = document.getElementById('theme-toggle');
  const root = document.documentElement;
  const systemDark = window.matchMedia('(prefers-color-scheme: dark)');
  const effective = () => root.dataset.theme || (systemDark.matches ? 'dark' : 'light');

  function paint() {
    if (!btn) return;
    const toLight = effective() === 'dark';
    btn.setAttribute('aria-label', toLight ? 'Switch to light theme' : 'Switch to dark theme');
    btn.title = btn.getAttribute('aria-label')!;
  }

  btn?.addEventListener('click', () => {
    const next = effective() === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    setPref('theme', next);
    paint();
  });
  systemDark.addEventListener('change', paint);
  paint();
</script>
