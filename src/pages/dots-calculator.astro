---
import BaseLayout from '../layouts/BaseLayout.astro';
import DotsCalculator from '../components/DotsCalculator.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import SourceList from '../components/SourceList.astro';
import AdSlot from '../components/AdSlot.astro';
import { DOTS_COEFFICIENTS, DOTS_BODYWEIGHT_RANGE, dotsScore } from '../lib/dots.js';
import { WILKS_COEFFICIENTS, WILKS_BODYWEIGHT_RANGE, IPF_GL_PARAMETERS, wilksScore, ipfGlScore } from '../lib/points.js';
import { webAppNode, webPageNode } from '../lib/schema';
import { LINKS } from '../data/links';
import { SITE, formatDate, reviewedFor } from '../config/site';

const title = 'DOTS, Wilks and IPF GL Calculator — Powerlifting Scores';
const description =
  'Calculate your DOTS, Wilks and IPF GL points: compare a powerlifting total across bodyweights for men and women. Enter your lifts or total in kg or lb.';
const path = '/dots-calculator/';
const site = (Astro.site?.toString() ?? '').replace(/\/$/, '');
const url = `${site}${path}`;
// Example rows computed with the tested scoring function.
const examples = [
  { sex: 'male' as const, bw: 75, total: 500 },
  { sex: 'male' as const, bw: 90, total: 600 },
  { sex: 'male' as const, bw: 110, total: 700 },
  { sex: 'female' as const, bw: 60, total: 300 },
  { sex: 'female' as const, bw: 75, total: 380 },
].map((e) => ({
  ...e,
  score: dotsScore(e.total, e.bw, e.sex).score,
  wilks: wilksScore(e.total, e.bw, e.sex).score,
  gl: ipfGlScore(e.total, e.bw, e.sex, 'classic').score as number,
}));
const fmt = (c: number) => String(c);
const jsonLd = [
  webPageNode({ site, url, name: title, description, reviewed: reviewedFor(path) }),
  webAppNode({ site, url, name: '1RMHub DOTS Calculator', description,
    features: ['DOTS score for men and women', 'Wilks score', 'IPF GL points (classic and equipped)', 'Total from squat, bench and deadlift', 'kg and lb'] }),
];
---
<BaseLayout title={title} description={description} path={path} crumbs={[{ name: 'DOTS Calculator', href: path }]} jsonLd={jsonLd}>
  <h1>DOTS, Wilks and IPF GL Calculator</h1>
  <p class="lead">
    Score your powerlifting total against your bodyweight with the DOTS, Wilks and IPF GL formulas,
    so lifters of different sizes can be compared on one scale.
  </p>
  <p class="page-meta">Last reviewed <time datetime={reviewedFor(path)}>{formatDate(reviewedFor(path))}</time></p>

  <DotsCalculator />

  <div class="prose">
    <section aria-labelledby="what-dots-heading">
      <h2 id="what-dots-heading">What is a DOTS score?</h2>
      <p class="answer">
        DOTS is a points formula for powerlifting. It divides your total (best squat + bench press +
        deadlift) by a curve based on bodyweight, so a lighter and a heavier lifter can be compared
        fairly. A higher score means a stronger total for your size.
      </p>
      <p>
        DOTS was developed by Tim Konertz and published in 2019. According to its author, the name
        stands for &ldquo;Dynamic Objective Team Scoring&rdquo;: it was first built for the German team
        league, to score team competitions fairly — including mixed teams of men and women. The German powerlifting federation (BVDK)
        replaced Wilks points with DOTS for its team competitions from 2020.
      </p>
    </section>

    <section aria-labelledby="dots-vs-heading">
      <h2 id="dots-vs-heading">How is DOTS different from Wilks and IPF points?</h2>
      <p>
        All three turn a total and a bodyweight into one comparable number, but they use different
        curves, so the same total gives different scores in each.
      </p>
      <ul>
        <li><strong>Wilks</strong> was created by Robert Wilks in the 1990s and was the main formula in the
          International Powerlifting Federation (IPF) until the IPF decided in 2018 to replace it.
          Konertz&rsquo;s criticism is that Wilks was fitted to the data available at the time, and with
          today&rsquo;s results it favours very light and very heavy men and very light women.</li>
        <li><strong>IPF points</strong> replaced Wilks in the IPF from 2019. The IPF still uses its own
          points formula, not DOTS.</li>
        <li><strong>DOTS</strong> was fitted to newer raw and equipped results with a smooth curve that keeps
          rising across the whole bodyweight range, and was designed so men&rsquo;s and women&rsquo;s scores
          can be compared in mixed teams. Its author set the scale so that typical scores are close to
          Wilks scores.</li>
      </ul>
      <p>
        No formula is &ldquo;correct&rdquo;: each is a model fitted to competition data. Use the one your
        federation or competition uses, and compare scores only within the same formula.
      </p>
    </section>

    <section aria-labelledby="formula-dots-heading">
      <h2 id="formula-dots-heading">The DOTS formula</h2>
      <p><code>DOTS = total × 500 ÷ (a + b·x + c·x² + d·x³ + e·x⁴)</code>, where <em>x</em> is bodyweight in kilograms and the total is in kilograms.</p>
      <div class="table-wrap">
        <table>
          <caption>DOTS coefficients</caption>
          <thead><tr><th scope="col">Coefficient</th><th scope="col" class="num">Men</th><th scope="col" class="num">Women</th></tr></thead>
          <tbody>
            {['a', 'b', 'c', 'd', 'e'].map((name, i) => (
              <tr><th scope="row">{name}</th><td class="num"><code>{fmt(DOTS_COEFFICIENTS.male[i])}</code></td><td class="num"><code>{fmt(DOTS_COEFFICIENTS.female[i])}</code></td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <p>
        The curves are fitted for bodyweights of {DOTS_BODYWEIGHT_RANGE.male.min}–{DOTS_BODYWEIGHT_RANGE.male.max} kg
        for men and {DOTS_BODYWEIGHT_RANGE.female.min}–{DOTS_BODYWEIGHT_RANGE.female.max} kg for women. Outside that
        range the calculator uses the nearest limit and tells you, as the formula&rsquo;s author
        specifies, because the curve stops making sense beyond it. Pound inputs are converted to kilograms (1 kg = 2.20462 lb) before scoring.
      </p>
    </section>

    <section aria-labelledby="wilks-heading">
      <h2 id="wilks-heading">The Wilks formula</h2>
      <p><code>Wilks = total × 500 ÷ (a + b·x + c·x² + d·x³ + e·x⁴ + f·x⁵)</code>, where <em>x</em> is bodyweight in kilograms.</p>
      <div class="table-wrap">
        <table>
          <caption>Wilks coefficients (original formula)</caption>
          <thead><tr><th scope="col">Coefficient</th><th scope="col" class="num">Men</th><th scope="col" class="num">Women</th></tr></thead>
          <tbody>
            {['a', 'b', 'c', 'd', 'e', 'f'].map((name, i) => (
              <tr><th scope="row">{name}</th><td class="num"><code>{fmt(WILKS_COEFFICIENTS.male[i])}</code></td><td class="num"><code>{fmt(WILKS_COEFFICIENTS.female[i])}</code></td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <p>
        These are the original Wilks coefficients, the ones most calculators and many federations
        still use. A revised version (sometimes called Wilks 2020 or Wilks2) uses different numbers and
        is not included here. Bodyweight is limited to {WILKS_BODYWEIGHT_RANGE.male.min}–{WILKS_BODYWEIGHT_RANGE.male.max} kg
        for men and {WILKS_BODYWEIGHT_RANGE.female.min}–{WILKS_BODYWEIGHT_RANGE.female.max} kg for women, where the curve
        stays sensible; outside it the calculator uses the nearest limit and tells you. The values match
        OpenPowerlifting&rsquo;s implementation and its test results.
      </p>
    </section>

    <section aria-labelledby="gl-heading">
      <h2 id="gl-heading">The IPF GL formula</h2>
      <p><code>IPF GL = total × 100 ÷ (A − B · e<sup>−C·x</sup>)</code>, where <em>x</em> is bodyweight in kilograms and <em>e</em> is the base of the natural logarithm.</p>
      <div class="table-wrap">
        <table>
          <caption>IPF GL parameters for full powerlifting</caption>
          <thead><tr><th scope="col">Category</th><th scope="col" class="num">A</th><th scope="col" class="num">B</th><th scope="col" class="num">C</th></tr></thead>
          <tbody>
            {([['Men, classic', IPF_GL_PARAMETERS.male.classic], ['Men, equipped', IPF_GL_PARAMETERS.male.equipped], ['Women, classic', IPF_GL_PARAMETERS.female.classic], ['Women, equipped', IPF_GL_PARAMETERS.female.equipped]] as const).map(([label, p]) => (
              <tr><th scope="row">{label}</th>{p.map((v) => <td class="num"><code>{fmt(v)}</code></td>)}</tr>
            ))}
          </tbody>
        </table>
      </div>
      <p>
        IPF GL (also called GOODLIFT) points are the IPF&rsquo;s own formula, introduced in 2020. The
        parameters are from the IPF&rsquo;s published document <em>The IPF GL Coefficients for Relative
        Scoring</em>, which uses separate values for classic (raw) and equipped lifting.
        The formula is not defined below 35 kg bodyweight.
      </p>
    </section>

    <section aria-labelledby="examples-heading">
      <h2 id="examples-heading">Example DOTS scores</h2>
      <div class="table-wrap">
        <table>
          <caption>DOTS, Wilks and IPF GL (classic) scores for example totals</caption>
          <thead><tr><th scope="col">Category</th><th scope="col" class="num">Bodyweight</th><th scope="col" class="num">Total</th><th scope="col" class="num">DOTS</th><th scope="col" class="num">Wilks</th><th scope="col" class="num">IPF GL</th></tr></thead>
          <tbody>
            {examples.map((e) => (
              <tr><th scope="row">{e.sex === 'male' ? 'Men' : 'Women'}</th><td class="num">{e.bw} kg</td><td class="num">{e.total} kg</td><td class="num">{e.score.toFixed(1)}</td><td class="num">{e.wilks.toFixed(1)}</td><td class="num">{e.gl.toFixed(1)}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section aria-labelledby="use-dots-heading">
      <h2 id="use-dots-heading">Using your score</h2>
      <ul>
        <li><strong>Use tested lifts.</strong> DOTS is meant for real competition-style singles. You can plug in estimated maxes from the <a href="/">1RM calculator</a>, but the result is then an estimate too.</li>
        <li><strong>Equipment matters.</strong> Raw and equipped totals are not comparable, even with the same score formula.</li>
        <li><strong>Federations differ.</strong> Some federations rank lifters with other formulas, such as IPF GL points or Wilks. Check which one your meet uses — scores from different formulas are not interchangeable.</li>
        <li><strong>Track yourself.</strong> The most useful comparison is your own score over time, especially if your bodyweight changes.</li>
      </ul>
    </section>

    <section aria-labelledby="dots-faq-heading">
      <h2 id="dots-faq-heading">DOTS score: common questions</h2>
      <h3>What is a good DOTS score?</h3>
      <p>
        There is no official scale of &ldquo;good&rdquo; scores. The best guide is to compare your
        score with results from the federation and division you compete in, or with your own past
        scores. The formula&rsquo;s author scaled DOTS so that typical scores are close to Wilks
        scores, so the two are roughly comparable in size — but never mix them in one ranking.
      </p>
      <h3>Can I enter my lifts in pounds?</h3>
      <p>
        Yes. Pick lb and the calculator converts your bodyweight and total to kilograms before
        scoring, because the formula is defined in kilograms. The score is the same either way.
      </p>
      <h3>Can DOTS compare men and women?</h3>
      <p>
        It was designed to score mixed teams fairly, using separate curves for men and women. Even so,
        it is a model fitted to competition results, so treat cross-sex comparisons as approximate.
      </p>
    </section>
  </div>

  <AdSlot />

  <RelatedLinks items={[LINKS.strength, LINKS.sinclair, LINKS.home, LINKS.squat]} />
  <SourceList ids={['konertz', 'bvdkdots', 'ipfgl', 'oplwilks']} />
</BaseLayout>
